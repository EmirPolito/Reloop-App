# Copia este archivo a `.env`, completa los valores y reinicia con `npx expo start -c`.
# Todo lo que empieza con EXPO_PUBLIC_ queda dentro de la app: nunca pongas aquí claves secretas.

# Firebase: Consola de Firebase > Configuración del proyecto > Tus apps > App web (</>) > "firebaseConfig"
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary: Dashboard > "Cloud name", y un upload preset SIN FIRMA (Settings > Upload > Upload presets)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Solo para desarrollo con los emuladores de Firebase (npm run emulators). Con esta variable puesta se ignoran las claves de Firebase de arriba.
# En el emulador de Android usa 10.0.2.2; en un teléfono físico, la IP de tu computadora.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
