{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8090"
      ],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "expo-web-emulador",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1&& npx expo start --web --port 8091"
      ],
      "port": 8091,
      "autoPort": false
    }
  ]
}